# Generated by the Form Engine bake; must stay byte-exact.
# -text disables core.autocrlf rewriting, so a fresh Windows checkout keeps the
# LF blob that the generator writes and matches Linux/CI.
_includes/form/app/** -text
assets/data/form-*.json -text

# Baseline snapshots are compared byte-for-byte by verify-render; a CRLF
# rewrite on checkout would make every fresh worktree fail for no real reason.
_form-engine/baseline/** -text
